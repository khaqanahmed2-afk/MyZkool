# MyZkool Environment Configuration Example
# Copy this file to .env and provide your actual credentials.

# Gemini AI API Key (Used by server for AI School Advisor and TTS)
GEMINI_API_KEY="your-gemini-api-key-here"

# Application URL (Used for canonical links, callbacks, and public previews)
APP_URL="http://localhost:3000"

# Supabase Configuration (Used for database, auth, and multi-tenant school storage)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Server Port (Optional, defaults to 3000)
PORT=3000
